{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3.12", "-B", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_commands.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
